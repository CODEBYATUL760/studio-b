// Mahakali Production - Prisma Schema Representation
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  client
}

enum PackageName {
  Mahakali_Plus_Full_HD @map("Mahakali Plus Full HD")
  Mahakali_Pro_4K       @map("Mahakali Pro 4K")
  Mahakali_Max_Asli_4K  @map("Mahakali Max Asli 4K")
  Mahakali_Ultra_Asli_4K @map("Mahakali Ultra Asli 4K")
}

enum EventType {
  Wedding
  Pre_Wedding   @map("Pre-Wedding")
  Ring_Ceremony @map("Ring Ceremony")
}

enum BookingStatus {
  Pending
  In_Production @map("In-Production")
  Completed
  Delivered
}

enum PaymentStatus {
  Paid
  Pending
  Overdue
}

enum InvoiceStatus {
  Unpaid
  Partially_Paid @map("Partially_Paid")
  Paid
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  full_name     String
  email         String          @unique
  phone         String?
  password_hash String?
  role          Role            @default(client)
  is_verified   Boolean         @default(false)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  
  orders        OrderBooking[]
  tokens        VerificationToken[]

  @@map("users")
}

model OrderBooking {
  id                     String        @id @default(uuid()) @db.Uuid
  client_id              String        @db.Uuid
  package_name           PackageName
  event_date             DateTime      @db.Date
  event_type             EventType
  total_amount           Decimal       @db.Decimal(12, 2)
  balance_due            Decimal       @db.Decimal(12, 2)
  status                 BookingStatus @default(Pending)
  delivery_estimate_days Int           @default(30)
  venue_location         String?
  special_instructions   String?
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  client                 User          @relation(fields: [client_id], references: [id], onDelete: Restrict)
  payments               PaymentEMI[]
  invoices               Invoice[]

  @@map("orders_bookings")
}

model PaymentEMI {
  id              String        @id @default(uuid()) @db.Uuid
  order_id        String        @db.Uuid
  installment_no  Int
  due_date        DateTime      @db.Date
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(Pending)
  transaction_ref String?
  paid_at         DateTime?     @db.Timestamptz(6)
  payment_method  String?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  order           OrderBooking  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, installment_no])
  @@map("payments_emi")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  order_id       String        @db.Uuid
  invoice_number String        @unique
  generated_date DateTime      @default(now()) @db.Timestamptz(6)
  pdf_url        String?
  payment_status InvoiceStatus @default(Unpaid)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  tax_amount     Decimal       @default(0) @db.Decimal(12, 2)
  total_amount   Decimal       @default(0) @db.Decimal(12, 2)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  order          OrderBooking  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model VerificationToken {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  email         String
  otp_code_hash String
  token_type    String    @default("email_verification")
  expires_at    DateTime  @db.Timestamptz(6)
  attempts      Int       @default(0)
  max_attempts  Int       @default(5)
  is_used       Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("verification_tokens")
}
